# Copy to .env (local) and set the same keys in Vercel → Project → Settings → Environment Variables.

# Neon pooled connection string
DATABASE_URL=

# ── Blog admin (/admin) ──
# The password you sign in with. Use a long passphrase; login attempts are only lightly throttled.
ADMIN_PASSWORD=
# 32+ random characters used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this (or the password) signs out every session.
ADMIN_SESSION_SECRET=

# Image uploads from the editor go to Cloudinary (folder: portfolio/blog)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ── Site assistant (/api/chat) ──
# Gemini API key from Google AI Studio.
GEMINI_API_KEY=
# Optional. Primary model, and fallbacks tried in order when it errors or is slow to respond.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Optional. Site-wide cap on assistant messages per day (default 2000).
# CHAT_DAILY_LIMIT=2000
